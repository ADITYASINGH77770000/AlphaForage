# ─────────────────────────────────────────────────────────────────────────────
# AlphaForge portal — environment
#
# API_URL is where next.config.mjs proxies every /api/* request. Because the
# proxy runs server-side, the browser only ever sees same-origin URLs and the
# backend host is never baked into the client bundle.
#
#   local dev   → leave unset; it defaults to http://127.0.0.1:8000
#   Vercel      → set to your deployed Render API, no trailing slash:
#                 https://alphaforge-api.onrender.com
# ─────────────────────────────────────────────────────────────────────────────

API_URL=http://127.0.0.1:8000
