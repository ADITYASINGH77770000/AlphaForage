{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m", "uvicorn", "api.server:app",
        "--host", "127.0.0.1", "--port", "8000"
      ],
      "port": 8000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm.cmd",
      "runtimeArgs": ["run", "dev"],
      "port": 3000,
      "cwd": "frontend"
    },
    {
      "name": "streamlit",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m", "streamlit", "run", "app/main.py",
        "--server.port", "8502",
        "--server.headless", "true"
      ],
      "port": 8502
    }
  ]
}
